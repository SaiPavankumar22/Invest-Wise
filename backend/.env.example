# Nebius AI Studio API Key (required — https://studio.nebius.ai)
NEBIUS_API_KEY=your_nebius_api_key_here

# Nebius API base URL (optional — defaults to https://api.studio.nebius.ai/v1)
# NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1

# Nebius model to use (optional — defaults to google/gemma-2-27b-it)
# NEBIUS_MODEL=google/gemma-2-27b-it

# YouTube Data API Key
YOUTUBE_API_KEY=your_youtube_api_key_here

# YouTube API base URL (optional — defaults to https://www.googleapis.com/youtube/v3)
# YOUTUBE_BASE_URL=https://www.googleapis.com/youtube/v3
